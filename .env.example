DATABASE_URL=postgresql+psycopg://edumap:edumap@postgres:5432/edumap
REDIS_URL=redis://redis:6379/0
WORKER_MAX_JOBS=2

NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

JWT_SECRET=change-me-in-production
JWT_EXPIRES_MINUTES=1440

GROQ_API_KEY=
GROQ_MODEL=
# groq = panggil API sungguhan; mock = jawaban offline dari konteks materi (demo tanpa API key)
LLM_MODE=groq
MOCK_LLM_DELAY_SECONDS=0.8

EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=20

POSTGRES_USER=edumap
POSTGRES_PASSWORD=edumap
POSTGRES_DB=edumap
