DATABASE_URL=postgresql+psycopg://edumap:edumap@postgres:5432/edumap
REDIS_URL=redis://redis:6379/0
WORKER_MAX_JOBS=2

# Port host untuk Docker Compose (ubah bersama tiga URL di bawah bila perlu)
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

JWT_SECRET=change-me-in-production
JWT_EXPIRES_MINUTES=1440

GROQ_API_KEY=
GROQ_MODEL=
# groq = panggil API sungguhan; mock = jawaban offline dari konteks materi (demo tanpa API key)
# groq | openai (gateway OpenAI-compatible, memakai API_KEY_LITELLM) | mock
LLM_MODE=groq
LLM_BASE_URL=https://senopati.its.ac.id/llm-gateway/v1
LLM_MODEL=qwen3:14b
API_KEY_LITELLM=
MOCK_LLM_DELAY_SECONDS=0.8

EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=20

POSTGRES_USER=edumap
POSTGRES_PASSWORD=edumap
POSTGRES_DB=edumap
