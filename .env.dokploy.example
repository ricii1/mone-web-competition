# Salin ke tab Environment service Compose Dokploy. Isi secret di dashboard saja.
# Gunakan dua domain yang diberikan panitia; contoh di bawah bukan domain aktif.
NEXT_PUBLIC_API_URL=https://api.example.invalid
NEXT_PUBLIC_WS_URL=wss://api.example.invalid
CORS_ORIGINS=https://belajar.example.invalid

POSTGRES_USER=petapintar
POSTGRES_DB=petapintar
# Buat dua nilai BERBEDA: openssl rand -hex 32 (jalankan dua kali).
# Password hex aman dimasukkan ke URL database tanpa percent-encoding.
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_MINUTES=1440

# Pilih openai (gateway ITS), groq, atau mock (demo tanpa API key).
LLM_MODE=openai
LLM_BASE_URL=https://senopati.its.ac.id/llm-gateway/v1
LLM_MODEL=qwen3:14b
API_KEY_LITELLM=
LLM_TIMEOUT_SECONDS=180
GROQ_API_KEY=
GROQ_MODEL=
MOCK_LLM_DELAY_SECONDS=0.8

WORKER_MAX_JOBS=2
EMBEDDING_MODEL=intfloat/multilingual-e5-small
MAX_UPLOAD_MB=20
